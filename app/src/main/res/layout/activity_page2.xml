<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:padding="16dp"
android:background="#42444b">


<TextView
    android:id="@+id/tvTitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="University Faculties and Majors"
    android:textSize="20dp"
    android:textStyle="bold"
    android:gravity="center"
    android:padding="16dp"
    android:textColor="#000000" />


<TextView
    android:id="@+id/tvFacultyLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Select Faculty:"
    android:textSize="16sp"
    android:layout_marginTop="16dp"
    android:textColor="@color/white" />

<Spinner
    android:id="@+id/spinnerFaculty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:drawable/btn_dropdown"
    android:backgroundTint="#09e5d2"
    android:layout_marginTop="8dp" />


<TextView
    android:id="@+id/tvMajorLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Select Major:"
    android:textSize="16sp"
    android:layout_marginTop="16dp"
    android:textColor="@color/white" />

<Spinner
    android:id="@+id/spinnerMajor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:drawable/btn_dropdown"
    android:backgroundTint="#09e5d2"
    android:layout_marginTop="8dp" />


<TextView
    android:id="@+id/tvSelection"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Selected Faculty and Major:"
    android:textSize="16sp"

    android:layout_marginTop="24dp"
    android:textStyle="bold"
    android:textColor="@color/white" />


<ImageView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"

    android:layout_marginTop="50dp"


    android:src="@drawable/univ1"

    />

<ImageButton
    android:id="@+id/btnback"

    android:layout_width="102dp"
    android:layout_height="wrap_content"

    android:layout_marginTop="20dp"

    android:background="#42444b"
    android:src="@drawable/partielback"


    >

</ImageButton>

</LinearLayout>


